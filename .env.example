# ── Rozaneh · روزنه — environment ────────────────────────────────────────────
# Local:  cp .env.example .env
# Railway: Settings → Variables (never commit a real .env).

# Panel password used on the very first boot (change it after the first login:
# Settings → امنیت).
ADMIN_PASSWORD=rozaneh

# Folder holding rozaneh.db — mount a Railway volume at /data
DATA_DIR=./data

# Timezone the scheduler uses for the "08:00" hours in your rules
DEFAULT_TZ=Asia/Tehran

# HTTP port (Railway injects PORT automatically)
PORT=8080

# Set to 1 when the panel is only reachable over HTTPS
COOKIE_SECURE=0

# Background scheduler (0 = manual runs only)
SCHEDULER_ENABLED=1

# Outbound HTTP timeout for feeds / messengers (seconds)
HTTP_TIMEOUT=20

# Base pause between two publishes (seconds). On top of this, publish.py keeps
# a per-channel gap (Telegram 3s, Bale 1.5s, Eitaa/Rubika 2s) so bots stay under
# the platform rate limits and never get a 429.
SEND_DELAY=0.8
